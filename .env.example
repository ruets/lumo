# --- Required ------------------------------------------------------------------
# Public URL of Lumo, as seen by browsers (behind the reverse proxy).
# In development with `pnpm dev`: http://localhost:5173
PUBLIC_URL=https://lumo.example.org
# At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=
# Path of the SQLite database (local volume, never NFS/SMB). In Docker: /data/lumo.db
DATABASE_PATH=./data/lumo.db

# --- Authentik (OIDC): all three together, or none ---------------------------
# Issuer of the OIDC application, with the trailing slash.
OIDC_ISSUER=https://auth.example.org/application/o/lumo/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Redirect URIs to declare in Authentik, in this same application:
#   ${PUBLIC_URL}/api/v1/auth/callback   (web)
#   lumo://auth                          (mobile: the app sends the code, the API exchanges it with the secret)
# Members of this Authentik group become owner. Empty to disable.
OIDC_ADMIN_GROUP=lumo-admins

# --- Local accounts (fallback, Argon2id) ----------------------------------------
LOCAL_AUTH_ENABLED=true

# --- Optional --------------------------------------------------------------------
# PORT=3000
# LOG_LEVEL=info
# Folder of the web build to serve (already set in the Docker image)
# WEB_DIST_PATH=../web/dist

# --- Litestream backup (docker-compose, backup service) --------------------
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
