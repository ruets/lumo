# --- Obligatoire ---------------------------------------------------------------
# URL publique de Lumo, telle que vue par les navigateurs (derrière le reverse proxy).
# En développement avec `pnpm dev` : http://localhost:5173
PUBLIC_URL=https://lumo.example.org
# Au moins 32 caractères aléatoires : `openssl rand -base64 48`
SESSION_SECRET=
# Chemin de la base SQLite (volume local, jamais NFS/SMB). Dans Docker : /data/lumo.db
DATABASE_PATH=./data/lumo.db

# --- Authentik (OIDC) : les trois ensemble, ou aucune --------------------------
# Issuer de l'application OIDC, avec le slash final.
OIDC_ISSUER=https://auth.example.org/application/o/lumo/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Redirect URIs à déclarer dans Authentik, dans cette même application :
#   ${PUBLIC_URL}/api/v1/auth/callback   (web)
#   lumo://auth                          (mobile : l'appli envoie le code, l'API l'échange avec le secret)
# Les membres de ce groupe Authentik deviennent owner. Vide pour désactiver.
OIDC_ADMIN_GROUP=lumo-admins

# --- Comptes locaux (secours, Argon2id) ----------------------------------------
LOCAL_AUTH_ENABLED=true

# --- Optionnel -----------------------------------------------------------------
# PORT=3000
# LOG_LEVEL=info
# Dossier du build web à servir (déjà réglé dans l'image Docker)
# WEB_DIST_PATH=../web/dist

# --- Sauvegarde Litestream (docker-compose, service backup) --------------------
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
