{
	"name": "@lumo/api-client",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"generate": "pnpm --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 dlx openapi-typescript ../../apps/api/openapi.json -o src/generated/schema.ts"
	}
}
