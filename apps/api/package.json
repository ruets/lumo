{
	"name": "@lumo/api",
	"version": "0.0.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"files": [
		"dist",
		"drizzle"
	],
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"openapi:generate": "tsx src/openapi-cli.ts"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.5",
		"@fastify/rate-limit": "^11.2.2",
		"@fastify/static": "^10.1.11",
		"@lumo/domain": "workspace:*",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"fastify": "^5.12.8",
		"jose": "^6.2.17",
		"openid-client": "^6.9.0",
		"zod": "^4.6.7"
	}
}
